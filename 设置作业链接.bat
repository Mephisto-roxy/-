@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0"
echo ============================================================
echo  配置你自己的「AI实践情景对话」页面链接
echo  怎么找: 平时浏览器登录学习通 - 进入课程 - 点开老师布置的
echo  AI实践/情景对话任务 - 打开对话页后复制地址栏整串链接
echo ============================================================
set /p MYURL=粘贴链接后回车(直接回车=跳过): 
if "%MYURL%"=="" (
  echo 未输入, 已跳过。之后也可手动在浏览器里打开作业页。
  pause
  exit /b 0
)
<nul set /p ="%MYURL%" > chat-url.txt
echo.
echo 已保存到 chat-url.txt 。下次启动助手会自动打开这个页面。
pause